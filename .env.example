# From your app's "Keys and tokens" tab at developer.x.com, under
# "OAuth 2.0 Client ID and Client Secret".
X_CLIENT_ID=
X_CLIENT_SECRET=

# Encrypts the session cookie AND the X tokens stored at rest in the
# database. Any long random string works — generate one with
# `openssl rand -base64 32` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Rotating this logs every signed-in user out AND makes stored tokens
# undecryptable — they'd need to sign in again.
SESSION_SECRET=

# Postgres connection string used by the app at runtime. Default: a
# Supabase project (same account as replylane) using the transaction
# pooler connection string, port 6543 — the client is already configured
# with `prepare: false` since that pooler doesn't support prepared
# statements. Neon is a fine alternative.
DATABASE_URL=

# Connection string used only by drizzle-kit to run migrations — the
# transaction pooler above doesn't support what the migration tool needs.
# Supabase: Project Settings -> Database -> Connection string -> "Session
# pooler" tab, port 5432 (NOT the "Direct connection" tab — that resolves
# IPv6-only, which Vercel's build environment can't reach at all, and
# fails near-instantly). Falls back to DATABASE_URL if unset.
DIRECT_URL=

# Phase 4: authenticates Vercel Cron's daily hit to /api/cron/revalidate.
# Vercel does NOT provision this automatically despite securing the route
# the way its docs describe — generate your own (`openssl rand -base64 24`
# or similar, 16+ chars) and set the *same* value here and in Vercel. The
# route checks it via `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Phase 6: the paid gate. All three come from your Whop dashboard — see
# DEPLOY.md for the exact setup steps (create a plan, an Account API key,
# and a webhook subscription pointed at /api/webhooks/whop).
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_ID=

# Optional. Unset uses production (https://api.whop.com/api/v1). Point
# this at https://sandbox-api.whop.com/api/v1 to test checkout/webhooks
# with fake money before going live — see DEPLOY.md.
WHOP_API_BASE_URL=

# --- Local phase0/*.mjs scripts only (not used by the live app) ---
# Must exactly match a callback URL registered on the app.
X_REDIRECT_URI=http://127.0.0.1:3000/callback
