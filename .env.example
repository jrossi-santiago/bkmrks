# From your app's "Keys and tokens" tab at developer.x.com, under
# "OAuth 2.0 Client ID and Client Secret".
X_CLIENT_ID=
X_CLIENT_SECRET=

# Encrypts the session cookie AND the X tokens stored at rest in the
# database. Any long random string works — generate one with
# `openssl rand -base64 32` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Rotating this logs every signed-in user out AND makes stored tokens
# undecryptable — they'd need to sign in again.
SESSION_SECRET=

# Postgres connection string. Default: a Supabase project (same account as
# replylane) using the transaction pooler connection string — the client is
# already configured with `prepare: false` since that pooler doesn't
# support prepared statements. Neon is a fine alternative.
DATABASE_URL=

# --- Local phase0/*.mjs scripts only (not used by the live app) ---
# Must exactly match a callback URL registered on the app.
X_REDIRECT_URI=http://127.0.0.1:3000/callback
