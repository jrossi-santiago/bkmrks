# From your app's "Keys and tokens" tab at developer.x.com, under
# "OAuth 2.0 Client ID and Client Secret".
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Live app (app/login + app/api/auth/callback) ---
# Reads X_CLIENT_ID / X_CLIENT_SECRET above. The redirect_uri is derived at
# request time from the incoming host, so no env var is needed for it — just
# register the deployed URL's /api/auth/callback as a callback URI on the X
# app (see DEPLOY.md).

# --- Local phase0/*.mjs scripts only (not used by the live app) ---
# Must exactly match a callback URL registered on the app.
X_REDIRECT_URI=http://127.0.0.1:3000/callback
