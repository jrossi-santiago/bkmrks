# From your app's "Keys and tokens" tab at developer.x.com, under
# "OAuth 2.0 Client ID and Client Secret".
X_CLIENT_ID=
X_CLIENT_SECRET=

# Encrypts the session cookie (access/refresh tokens). Any long random
# string works — generate one with `openssl rand -base64 32` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Rotating this logs every signed-in user out (their cookie stops decrypting).
SESSION_SECRET=

# --- Local phase0/*.mjs scripts only (not used by the live app) ---
# Must exactly match a callback URL registered on the app.
X_REDIRECT_URI=http://127.0.0.1:3000/callback
