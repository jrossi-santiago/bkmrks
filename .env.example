# From your app's "Keys and tokens" tab at developer.x.com, under
# "OAuth 2.0 Client ID and Client Secret".
X_CLIENT_ID=
X_CLIENT_SECRET=

# Must exactly match a callback URL registered on the app (User authentication
# settings -> Callback URI / Redirect URL). http://127.0.0.1:3000/callback
# works for this manual, no-server spike.
X_REDIRECT_URI=http://127.0.0.1:3000/callback
